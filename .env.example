# ============================================================
# VUE 환경변수 목록 (변수명만 — 실제 값은 .env.local 에만 넣으세요)
# 이 파일은 git에 올려도 안전합니다.
# ============================================================

# ---------- Supabase (로그인 + 데이터베이스) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI 대화 (무료 API, 서버 전용) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ---------- 관리자 ----------
ADMIN_EMAILS=

# ---------- Google Analytics 4 ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=""

# ---------- 환영 메일 (Gmail SMTP) ----------
WELCOME_EMAIL_ENABLED=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 배포 주소 (메일 속 이미지·링크 절대경로용) — 예: https://dejavue-chat.vercel.app
NEXT_PUBLIC_SITE_URL=

# ---------- (보관) Resend — 도메인 인증 후 복귀용 ----------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
