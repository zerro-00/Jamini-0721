# ============================================================
# VUE 환경변수 템플릿
# 이 파일을 복사해서 ".env.local" 이라는 이름으로 저장한 뒤,
# SETUP.md 를 따라 각 값을 채워 넣으세요.
# NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 공개되고,
# 나머지는 전부 서버에서만 사용되는 비밀 값입니다.
# ============================================================

# ---------- Supabase (로그인 + 데이터베이스) ----------
# Supabase 대시보드 → Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [서버 전용/비밀] service_role 키 — 관리자 기능(회원 목록, 캐릭터 관리)에 사용
SUPABASE_SERVICE_ROLE_KEY=

# ---------- OpenAI (AI 대화) ----------
# [서버 전용/비밀] https://platform.openai.com/api-keys 에서 발급
# 절대 NEXT_PUBLIC_ 을 붙이지 마세요!
OPENAI_API_KEY=
# 사용할 모델 (그대로 두면 됩니다)
OPENAI_MODEL=gpt-4o-mini

# ---------- 관리자 ----------
# 관리자로 인정할 구글 이메일. 여러 명이면 쉼표로 구분
# 예: ADMIN_EMAILS=zerro@yonsei.ac.kr,another@gmail.com
ADMIN_EMAILS=

# ---------- Google Analytics 4 ----------
# (A) 방문자 추적용 측정 ID — 웹페이지에 심는 용도. 예: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# (B) 관리자 대시보드가 GA 데이터를 "읽어올 때" 쓰는 값들 (전부 서버 전용/비밀)
# GA4 속성 ID — 숫자만. 예: 123456789
GA_PROPERTY_ID=
# 구글 클라우드 서비스 계정 이메일 — 예: vue-dashboard@프로젝트명.iam.gserviceaccount.com
GA_CLIENT_EMAIL=
# 서비스 계정 비공개 키 — JSON 키 파일의 "private_key" 값을 통째로 붙여넣기
# 주의: 반드시 큰따옴표로 감싸고, \n 문자는 그대로 두세요. SETUP.md 7번 참조
GA_PRIVATE_KEY=""
